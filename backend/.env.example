# InkSight Backend

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://inksight:password@localhost:5432/inksight?schema=public

# JWT
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long
JWT_REFRESH_EXPIRATION=7d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=inksight-designs
S3_PRESIGNED_URL_TTL=300

# Share Tokens
SHARE_TOKEN_DEFAULT_TTL=86400
SHARE_TOKEN_MAX_USES=10
